[Obsidian]
# FALLBACK CONFIGURATION: These paths are only used if the --workspace argument
# is not passed to the script. When --workspace is provided, the script will
# dynamically infer U:\voothi.vault\<project> and auto-discover the active conversation.

# Path to the conversations folder inside the vault
conversations_dir = U:\voothi.vault\default\conversations

# Default active conversation markdown file to update
active_conversation = U:\voothi.vault\default\conversations\20260529200151-conversation.md

# Automatically create the vault project folder in vault_base if it doesn't exist,
# instead of falling back to default configuration.
auto_create_project = true
# Ensure conversations\root.md exists at startup (idempotent).
ensure_root_note = true
# Ensure an active *-conversation.md exists at startup (idempotent).
ensure_active_conversation = true

# Optional template used only when root.md is missing. Leave empty for built-in minimal template.
root_note_template_path = 

# Tooltip display duration in milliseconds (e.g. 4000 for 4 seconds).
# If empty or 0, tooltips are disabled completely.
tooltip = 4000

# Whether the AHK launcher should auto-paste generated wikilinks back
# into the active editor after processing.
# false = update conversation file only (recommended default)
auto_paste_wikilinks = false


[Parser]
# Number of words to retain in the filename slug
slug_word_count = 4

# Whether to split the first sentence as task title and the rest as description
split_description = True

# Whether to save the full original message text inside the note description
one_to_one = True

# Comma-separated list of line prefixes to ignore during ZID and title scanning (preserves trailing spaces)
ignore_prefixes = Edited ,Viewed ,Ran command:,Created At:,Completed At:,Created file ,Stdout:,Stderr:



